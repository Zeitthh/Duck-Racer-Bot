# Template: copy this file to .env and fill in the values there. Do not put real data in this file.

# Discord Developer Portal -> your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Server in which the commands are registered (they update instantly)
DISCORD_DEV_GUILD_ID=

# SQLite database. Relative paths start from the repository root.
DATABASE_URL=file:./data/duckbot.db

# Folder with the artwork: accessories.json (cosmetics) and catalog/*.duck.json (catalog ducks).
# A relative path starts from the repository root. By default, assets/ with a minimal sample; to keep your own
# artwork outside the repository, put its path here, e.g. ASSETS_DIR=D:/my-artwork
ASSETS_DIR=assets

# Fallback language when Discord does not report a supported one: en-US | es-419
DEFAULT_LOCALE=en-US
# debug | info | warn | error
LOG_LEVEL=debug

# Server time zone (IANA): daily limits (races, /daily) reset at midnight in this zone
TIMEZONE=UTC
# Name of the channel (without #) for level-up announcements
