# Plantilla: copia este archivo a .env y rellena los valores ahí. No pongas datos reales en este archivo.

# Discord Developer Portal -> tu aplicación
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Servidor donde se registran los comandos (se actualizan al instante)
DISCORD_DEV_GUILD_ID=

# SQLite en local. Las rutas relativas parten de la raíz del repo.
DATABASE_URL=file:./data/duckbot.db

# Carpeta con el arte: accessories.json (cosméticos) y catalog/*.duck.json (patos del catálogo).
# Una ruta relativa parte de la raíz del repo. Por defecto, assets/ con un ejemplo mínimo; para usar tu propio arte
# fuera del repositorio, pon aquí su ruta, p. ej. ASSETS_DIR=D:/DuckBot-assets
ASSETS_DIR=assets

# Idioma si Discord no informa uno conocido: es-419 | en-US
DEFAULT_LOCALE=es-419
# debug | info | warn | error
LOG_LEVEL=debug

# Zona horaria del servidor (IANA): a medianoche en esa zona se reinician las carreras y el /diario
TIMEZONE=America/Mexico_City
# Canal (por nombre, sin #) donde se anuncian las subidas de nivel
LEVEL_UP_CHANNEL=duckbot
# Rol que reciben quienes adoptan un pato (el bot lo crea si no existe)
ADOPTER_ROLE=Adoptador de patos
